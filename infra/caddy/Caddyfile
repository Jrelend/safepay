# SafePay private STAGING edge (HTTPS only). All payments are simulated.
# Values come from the caddy service environment (see compose.staging.yaml).
# Two sites, one certificate each (automatic HTTPS: Let's Encrypt via HTTP-01/TLS-ALPN-01,
# or Caddy's internal CA):
#   {$STAGING_DOMAIN}      the web app; browsers call the API same-origin under /api/*
#   {$STAGING_API_DOMAIN}  the public API for non-browser clients (same API process, same
#                          app-level CSRF/Origin checks; admin API, docs and probes are NOT served)
# Neither site sets HSTS includeSubDomains or any cookie Domain, so a parent domain
# (e.g. dhdbot.xyz) and its other sites are not affected.
{
	admin off
	servers {
		protocols h1 h2
	}
}

# Internal liveness endpoint for the container healthcheck (never published).
http://127.0.0.1:8080 {
	respond /healthz 200
}

{$STAGING_DOMAIN} {
	# "internal" = Caddy's own CA (local/CI); an email address = Let's Encrypt (real domain).
	tls {$CADDY_TLS}

	# Private access, layer 1: only listed networks (default: everyone; set it!).
	@outside not remote_ip {$ALLOWED_IPS}
	respond @outside "Forbidden" 403

	# Layer 1b: the admin area is restricted further.
	@admin_outside {
		path /admin /admin/* /api/admin/*
		not remote_ip {$ADMIN_ALLOWED_IPS}
	}
	respond @admin_outside "Forbidden" 403

	# Private access, layer 2: one shared credential for the whole beta site.
	# The app's own login, CSRF and (for admins) password + TOTP still apply behind it.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Caddy ignores client-supplied X-Forwarded-For (no trusted_proxies set) and sends
	# the real client address, which the web proxy forwards to the API for rate limits.
	reverse_proxy web:3000 {
		header_up -Authorization
	}

	# No access log: URLs can carry one-time tokens (invites, verification links).
}

{$STAGING_API_DOMAIN} {
	tls {$CADDY_TLS}

	# Same private-access layers as the web site.
	@outside not remote_ip {$ALLOWED_IPS}
	respond @outside "Forbidden" 403

	# Never on the public API host: the admin API (separate service, reached only via the
	# web origin with its own allow-list), interactive docs/schema, probes, dev helpers.
	@not_public path /admin /admin/* /docs /docs/* /redoc /openapi.json /health /ready /dev /dev/*
	respond @not_public "Not Found" 404

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Straight to the public API (safepay_app role). The client address is set by Caddy,
	# never taken from the client, so the API's rate limits see the real address.
	reverse_proxy api:8000 {
		header_up -Authorization
		header_up X-Forwarded-For {remote_host}
	}
}
