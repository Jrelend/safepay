# SafePay private STAGING — example environment. SIMULATION ONLY.
# Do not edit by hand to add secrets: run scripts/staging-init-secrets.sh, which
# writes .env.staging (git-ignored, chmod 600) with freshly generated values.
# Every CHANGE_ME must be replaced; the staging scripts refuse to run otherwise.

# --- Public entry point -------------------------------------------------------
# The DNS name testers open (an A/AAAA record pointing at the VPS).
STAGING_DOMAIN=staging.example.mn
# TLS: "internal" (Caddy's own CA; browsers warn — fine for a closed test) or an
# email address to obtain a trusted Let's Encrypt certificate for STAGING_DOMAIN.
CADDY_TLS=internal
# Interface to publish 80/443 on (0.0.0.0 on the VPS).
STAGING_BIND=0.0.0.0

# --- Private access controls (Caddy) -------------------------------------------
# Space-separated CIDRs allowed to reach the site at all, e.g. office + VPN.
ALLOWED_IPS="0.0.0.0/0 ::/0"
# Space-separated CIDRs allowed to reach /admin and /api/admin (keep it tight).
ADMIN_ALLOWED_IPS="127.0.0.1/32"
# One shared HTTP basic-auth login in front of the whole site.
BASIC_AUTH_USER=safepay-beta
# bcrypt hash from `caddy hash-password`; keep the single quotes ($ signs).
BASIC_AUTH_HASH='CHANGE_ME'

# --- PostgreSQL (internal only; never published) --------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=safepay
POSTGRES_PASSWORD=CHANGE_ME
SAFEPAY_MIGRATOR_PASSWORD=CHANGE_ME
SAFEPAY_APP_PASSWORD=CHANGE_ME
SAFEPAY_SYSTEM_PASSWORD=CHANGE_ME
SAFEPAY_ADMIN_PASSWORD=CHANGE_ME

# --- Backups ----------------------------------------------------------------------
BACKUP_DIR=./backups
# Daily backups kept for this many days; Sunday backups also kept as weekly.
BACKUP_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
# Optional: an `age` public key (age1...). If set, backups are encrypted with it.
BACKUP_AGE_RECIPIENT=
