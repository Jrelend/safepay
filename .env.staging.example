# SafePay private STAGING — example environment. SIMULATION ONLY.
# Do not edit by hand to add secrets: run scripts/staging-init-secrets.sh, which
# writes .env.staging (git-ignored, chmod 600) with freshly generated values.
# Every CHANGE_ME must be replaced; the staging scripts refuse to run otherwise.

# --- Public entry points --------------------------------------------------------
# Web app (testers open this; the browser calls the API same-origin at /api/*).
# Both names need an A record pointing at the droplet; see docs/DEPLOY_DIGITALOCEAN.md.
# scripts/staging-check-dns.sh verifies both resolve to this server.
STAGING_DOMAIN=safepay.dhdbot.xyz
# Public API host for non-browser clients (no admin API, docs or probes on it).
STAGING_API_DOMAIN=api.safepay.dhdbot.xyz
# TLS: "internal" (Caddy's own CA; browsers warn — fine for a closed test) or an
# email address to obtain trusted Let's Encrypt certificates for both hosts
# (needs ports 80/443 reachable from the internet and correct DNS first).
CADDY_TLS=internal
# Interface to publish 80/443 on (0.0.0.0 on the VPS).
STAGING_BIND=0.0.0.0

# --- Private access controls (Caddy) -------------------------------------------
# Space-separated CIDRs allowed to reach the site at all, e.g. office + VPN.
ALLOWED_IPS="0.0.0.0/0 ::/0"
# Space-separated CIDRs allowed to reach /admin and /api/admin (keep it tight).
ADMIN_ALLOWED_IPS="127.0.0.1/32"
# Who must enter the shared basic-auth login below:
#   private  everyone, on the whole web site (closed beta; the default)
#   public   only the admin area (/admin, /api/admin); the web app is open to all and
#            relies on its own login. The API host stays behind basic auth either way.
# Do not switch to public until real email verification is in place (emails are simulated).
SITE_ACCESS=private
# One shared HTTP basic-auth login (see SITE_ACCESS for where it applies).
BASIC_AUTH_USER=safepay-beta
# bcrypt hash from `caddy hash-password`; keep the single quotes ($ signs).
BASIC_AUTH_HASH='CHANGE_ME'

# --- PostgreSQL (internal only; never published) --------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=safepay
POSTGRES_PASSWORD=CHANGE_ME
SAFEPAY_MIGRATOR_PASSWORD=CHANGE_ME
SAFEPAY_APP_PASSWORD=CHANGE_ME
SAFEPAY_SYSTEM_PASSWORD=CHANGE_ME
SAFEPAY_ADMIN_PASSWORD=CHANGE_ME

# --- Backups ----------------------------------------------------------------------
BACKUP_DIR=./backups
# Daily backups kept for this many days; Sunday backups also kept as weekly.
BACKUP_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_WEEKS=8
# Strongly recommended on a VPS: an `age` public key (age1...). Backups are then
# encrypted with it. Dumps contain password hashes and admin TOTP secrets.
# Generate the key pair OFF the server (age-keygen) and keep the private key offline.
BACKUP_AGE_RECIPIENT=
