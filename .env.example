# SafePay Beta v0.1 — example environment.
# Copy to `.env` and adjust. NEVER commit `.env`.
# Every value below is a non-secret placeholder for local development only.
# SafePay is a SIMULATION: there are no payment-provider keys, and there never
# should be in this beta.

# --- Application -----------------------------------------------------------
# local | test | staging | production  (production disables /docs)
APP_ENV=local
# Must stay true. The API refuses to start with any other value.
PAYMENTS_SIMULATION_ONLY=true

# --- PostgreSQL (used by docker compose) -----------------------------------
POSTGRES_USER=safepay
# Use letters/digits only (it is embedded in a URL). Generate a strong one for
# any shared or VPS environment, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=local-dev-password-change-me
POSTGRES_DB=safepay
# Host port for the database (dev override only).
POSTGRES_PORT=5432

# --- Published ports (docker compose) --------------------------------------
# Keep 127.0.0.1 on a VPS and put a TLS reverse proxy in front.
BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_PORT=3000

# --- API ---------------------------------------------------------------------
# JSON list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Only needed when running the API outside Docker (uv run ...).
DATABASE_URL=postgresql+psycopg://safepay:local-dev-password-change-me@localhost:5432/safepay
# Disposable database for integration tests. Name MUST end in _test (it is wiped).
TEST_DATABASE_URL=postgresql+psycopg://safepay:local-dev-password-change-me@localhost:5432/safepay_test

# --- Web ---------------------------------------------------------------------
# Server-side URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:8000
