# SafePay Beta v0.1 — example environment.
# Copy to `.env` and adjust. NEVER commit `.env`.
# Every value below is a non-secret placeholder for local development only.
# SafePay is a SIMULATION: there are no payment-provider keys, and there never
# should be in this beta.

# --- Application -----------------------------------------------------------
# local | test | staging | production  (production disables /docs)
APP_ENV=local
# Must stay true. The API refuses to start with any other value.
PAYMENTS_SIMULATION_ONLY=true

# --- PostgreSQL (used by docker compose) -----------------------------------
# Five separate credentials. Use letters/digits only (they are embedded in
# URLs). For any shared or VPS environment generate each with
# `openssl rand -hex 24` and never reuse them.
#
# Superuser: used only to initialise a fresh volume. Nothing at runtime uses it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-superuser-password-change-me
POSTGRES_DB=safepay
# safepay_migrator owns the schema and is used only by `alembic upgrade`.
SAFEPAY_MIGRATOR_PASSWORD=local-migrator-password-change-me
# safepay_app is the least-privileged role the public API runs as.
SAFEPAY_APP_PASSWORD=local-app-password-change-me
# safepay_system: background worker only (expiry, auto-release).
SAFEPAY_SYSTEM_PASSWORD=local-system-password-change-me
# safepay_admin: admin API only (dispute decisions, suspensions).
SAFEPAY_ADMIN_PASSWORD=local-admin-password-change-me
# Host port for the database (dev override only).
POSTGRES_PORT=5432

# --- Published ports (docker compose) --------------------------------------
# Keep 127.0.0.1 on a VPS and put a TLS reverse proxy in front.
BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_PORT=3000

# --- API ---------------------------------------------------------------------
# JSON list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Only needed when running the API / Alembic outside Docker (uv run ...).
# Runtime connection: ALWAYS the least-privileged app role (/ready returns 503
# if this is a superuser or the schema owner).
DATABASE_URL=postgresql+psycopg://safepay_app:local-app-password-change-me@localhost:5432/safepay
# Migrations only: the schema-owning migrator role (never a superuser).
MIGRATION_DATABASE_URL=postgresql+psycopg://safepay_migrator:local-migrator-password-change-me@localhost:5432/safepay
# Disposable database for integration tests. Must be a SUPERUSER URL (the
# tests reset the schema and bootstrap the roles), and the database name MUST
# end in _test (it is wiped). Use a dedicated test cluster.
TEST_DATABASE_URL=postgresql+psycopg://postgres:local-superuser-password-change-me@localhost:5432/safepay_test

# Public URL of the web app (used in simulated email links).
PUBLIC_WEB_URL=http://localhost:3000
# Simulated inbox at /dev/mailbox for verification and reset emails.
# Only honoured when APP_ENV is local or test. NEVER enable on a shared server.
DEV_MAILBOX_ENABLED=true
# Worker pass interval (seconds).
WORKER_INTERVAL_SECONDS=60
# Only for running the worker outside Docker:
SYSTEM_DATABASE_URL=postgresql+psycopg://safepay_system:local-system-password-change-me@localhost:5432/safepay

# --- Web ---------------------------------------------------------------------
# Server-side URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:8000
ADMIN_API_INTERNAL_URL=http://localhost:8001
